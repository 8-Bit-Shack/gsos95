; ================================================================
; GS/OS95: Bluescreen wie bei Windows 95 (nur zum Spass, nichts stuerzt ab)
; Wahl-Apfel-C auf dem Schreibtisch ("Chef kommt"). Eine Taste oder ein
; Klick holt den Schreibtisch zurueck. XCODE4 (x4.s).
; ================================================================
BS_X = 22                       ; linker Rand des Textes
xf_bsod:
        CALL cur_hide
        ldx #$1E                ; Palette 0: blau, weiss, grau
@p:     TBL bs_pal
        sta f:$E19E00,x
        dex
        dex
        bpl @p
        ldx #198
        lda #0
@s:     sta f:$E19D00,x         ; alle Zeilen: 320er-Modus, Palette 0
        dex
        dex
        bpl @s
        ldx #0                  ; Schirm blau
        lda #0
@c:     sta f:$E12000,x
        inx
        inx
        cpx #32000
        bcc @c
        lda DXO                 ; Ursprung = Schirm, ganzer Schirm
        pha
        lda DYO
        pha
        stz DXO
        stz DYO
        stz KL
        stz KT
        lda #320
        sta KR
        sta CLIPR
        lda #200
        sta KB
        lda #130                ; Kasten mit "GS/OS95"
        sta RX
        lda #44
        sta RY
        lda #60
        sta RW
        lda #11
        sta RH
        lda #2
        CALL setcolor
        CALL fillrect
        lda #0
        CALL setcolor
        lda #141
        sta SX
        lda #46
        sta SY
        lda #bs_title
        jsr bs_str
        lda #1                  ; Text weiss
        CALL setcolor
        lda #64
        sta SY
        lda #bs_de
        ldx LANG
        beq @l0
        lda #bs_en
@l0:    sta BSP
@l:     lda #BS_X
        sta SX
        lda BSP
        jsr x4_kb
        lda [LP2]
        and #$00FF
        cmp #$FF
        beq @w
        pha
        lda BSP
        jsr bs_str
        pla
        sec
        adc BSP
        sta BSP
        lda SY
        clc
        adc #10
        sta SY
        bra @l
@w:     pla
        sta DYO
        pla
        sta DXO
@ev:    pha                     ; warten: Taste oder Klick
        pea $FFFF
        pea $0000
        lda EVPTR
        pha
        TOOL $0A06              ; GetNextEvent
        pla
        beq @ev
        lda EVREC
        cmp #1
        beq @go
        cmp #3
        bne @ev
@go:
        JSLF xf_set_palettes
        CALL desktop_scb
        CALL clip_full
        CALL redraw_all
        CALL cur_show
        rtl

; Text A (Laenge + Zeichen, diese Bank) bei SX/SY
bs_str: sta PDST
        phk
        sep #$20
        pla
        rep #$20
        and #$00FF
        sta PDST+2
        JSLF xf_ui_s2
        rts

